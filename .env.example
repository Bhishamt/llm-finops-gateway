# Copy to .env and fill in. Never commit .env.

# Default provider: ollama | azure_openai | openai_compat. Every provider configured below is
# available at the same time; config/pricing.yaml says which one serves each model (ADR-0011).
LFG_PROVIDER=ollama

# Ollama
LFG_OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI (required when LFG_PROVIDER=azure_openai)
# LFG_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# LFG_AZURE_OPENAI_API_KEY=
# LFG_AZURE_OPENAI_AUTH=api_key                # or entra: managed identity / az login, no key (needs [azure])
# LFG_AZURE_OPENAI_API_VERSION=2024-10-21
# JSON map: model name clients send -> Azure deployment name
# LFG_AZURE_OPENAI_DEPLOYMENTS={"gpt-4o-mini": "gpt-4o-mini-eastus", "gpt-4o": "gpt-4o-prod"}

# Any OpenAI-compatible server (required when LFG_PROVIDER=openai_compat, ADR-0010):
# Azure OpenAI v1 endpoint, vLLM, LocalAI, OpenAI. Base URL includes the API prefix.
# LFG_OPENAI_COMPAT_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# LFG_OPENAI_COMPAT_API_KEY=                 # sent as Authorization: Bearer; omit for open local servers
# JSON map: model name clients send -> upstream model / deployment name
# LFG_OPENAI_COMPAT_MODELS={"gpt-4o-mini": "gpt-4o-mini-eastus"}
# LFG_OPENAI_COMPAT_HEADERS={"X-Custom": "value"}

# Who is calling (ADR-0006): api_key (default, keys in config/keys.yaml) or headers (dev only)
LFG_AUTH_MODE=headers
LFG_KEYS_PATH=config/keys.yaml

# Config files, storage
LFG_PRICING_PATH=config/pricing.yaml
LFG_POLICIES_PATH=config/policies.yaml
LFG_DATABASE_URL=sqlite:///./gateway.db
LFG_REQUEST_TIMEOUT_SECONDS=120

# Report page: extra display currencies as units per 1 price-book unit (display only)
# LFG_REPORT_RATES={"EUR": 0.88}

# Alerts (ADR-0017): budget warn/block and upstream failures, one JSON POST per event per cooldown
# LFG_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
# LFG_ALERT_COOLDOWN_SECONDS=3600

# Observability
LFG_METRICS_ENABLED=true
# LFG_OTEL_ENABLED=true                      # needs: pip install "llm-finops-gateway[otel]"
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Langfuse: endpoint https://cloud.langfuse.com/api/public/otel and
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(pk:sk)>
