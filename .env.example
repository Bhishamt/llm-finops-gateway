# Copy to .env and fill in. Never commit .env.

# ollama | azure_openai
LFG_PROVIDER=ollama

# Ollama
LFG_OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI (required when LFG_PROVIDER=azure_openai)
# LFG_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# LFG_AZURE_OPENAI_API_KEY=
# LFG_AZURE_OPENAI_API_VERSION=2024-10-21
# JSON map: model name clients send -> Azure deployment name
# LFG_AZURE_OPENAI_DEPLOYMENTS={"gpt-4o-mini": "gpt-4o-mini-eastus", "gpt-4o": "gpt-4o-prod"}

# Who is calling (ADR-0006): api_key (default, keys in config/keys.yaml) or headers (dev only)
LFG_AUTH_MODE=headers
LFG_KEYS_PATH=config/keys.yaml

# Config files, storage
LFG_PRICING_PATH=config/pricing.yaml
LFG_POLICIES_PATH=config/policies.yaml
LFG_DATABASE_URL=sqlite:///./gateway.db
LFG_REQUEST_TIMEOUT_SECONDS=120

# Observability
LFG_METRICS_ENABLED=true
# LFG_OTEL_ENABLED=true                      # needs: pip install "llm-finops-gateway[otel]"
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Langfuse: endpoint https://cloud.langfuse.com/api/public/otel and
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(pk:sk)>
